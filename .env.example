# ==============================================================================
# SvelteKit 2 + PostgreSQL Notes Application - Environment Configuration
# ==============================================================================

# PostgreSQL database connection string (Serverless pooler compatible, e.g. Neon, Supabase, Vercel Postgres)
DATABASE_URL=postgres://moonday:moonday@localhost:5433/moonday

# Serverless Connection Pool Maximum Connections (Default: 10 for serverless functions)
DB_MAX_CONNECTIONS=10

# Cryptographically secure session secret / cookie key (at least 32 characters)
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_chars

# Node execution environment ('development' | 'production' | 'test')
NODE_ENV=development

# Public Application URL (Base URL for canonical links, cookies, redirects, and CORS)
PUBLIC_APP_URL=http://localhost:5173

# Google OAuth 2.0 credentials for "Save to Google Drive" export
# Create at https://console.cloud.google.com/apis/credentials (OAuth client type: Web application)
# Authorized redirect URI: <your origin>/google/callback (e.g. http://localhost:5173/google/callback)
# Enable the Google Drive API for the project. Leave blank to disable the feature.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
